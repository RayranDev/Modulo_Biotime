# ==============================================================================
# BIOTIME · PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y completa tus credenciales.
# ==============================================================================

# --- Servidor y Autenticación ---
BIOTIME_BASE_URL=http://172.16.1.252
BIOTIME_USER=admin
BIOTIME_PASS=tu_clave_aqui

# --- Rendimiento de Red ---
BIOTIME_TIMEOUT=60
BIOTIME_PAGE_SIZE=500
BIOTIME_VERIFY_SSL=false

# --- Endpoints Base (Personal & Organización) ---
BIOTIME_EP_TOKEN=/jwt-api-token-auth/
BIOTIME_EP_EMPLEADOS=/personnel/api/employees/
BIOTIME_EP_EMPLEADO_ADD=/personnel/employee/add/
BIOTIME_EP_EMPLEADO_EDIT=/personnel/employee/edit/
BIOTIME_EP_DEPARTAMENTOS=/personnel/api/departments/
BIOTIME_EP_CARGOS=/personnel/api/positions/
BIOTIME_EP_AREAS=/personnel/api/areas/
BIOTIME_EP_EMPRESAS=/personnel/api/company/
BIOTIME_EP_COMPANIAS=/personnel/api/department/tree/
BIOTIME_EP_CENTROS_COSTOS=/personnel/api/costcenters/

# --- Endpoints Base (Asistencia & Turnos) ---
BIOTIME_EP_TRANSACC=/iclock/api/transactions/
BIOTIME_EP_TIMEINTERVALS=/att/api/timeintervals/
BIOTIME_EP_SHIFT_DETAILS=/att/api/shift_details/
BIOTIME_EP_ATTSHIFTS=/att/api/attshifts/
BIOTIME_EP_ATTSCHEDULES=/att/api/attschedules/
BIOTIME_EP_TEMPSCHEDULES=/att/api/tempschedules/
BIOTIME_EP_LEAVE=/att/api/leave/
BIOTIME_EP_BREAKTIME=/att/api/breaktime/

# --- Endpoints Base (Dispositivos & Terminales) ---
BIOTIME_EP_TERMINALS=/iclock/api/terminals/
BIOTIME_EP_DEVICE_STATUS=/base/api/deviceStatus/

# --- Endpoints Candidatos (separados por coma en orden de prioridad) ---
BIOTIME_EP_TURNOS_CANDIDATOS=/att/api/attshifts/,/att/api/timeintervals/,/att/api/shift/
BIOTIME_EP_HORARIOS_CANDIDATOS=/att/api/attschedules/,/att/api/tempschedules/,/att/api/empSchedule/

# --- Endpoints Oficiales de Motor de Cálculo y Reportes BioTime ---
BIOTIME_EP_CALCULATION=/att/calculation_view/
BIOTIME_EP_SETTLEMENT_CALC=/att/settlement_calculation/
BIOTIME_EP_DAILY_HOURS=/att/api/dailyHourReport/
BIOTIME_EP_FIRST_LAST_REPORT=/att/api/firstLastReport/
BIOTIME_EP_DAILY_ATT_REPORT=/att/api/dailyAttendanceReport/
BIOTIME_EP_LATE_REPORT=/att/api/lateReport/
BIOTIME_EP_ABSENT_REPORT=/att/api/absentReport/
BIOTIME_EP_PAYROLL_CONCEPTS=/att/payrollconceptcode/table/

